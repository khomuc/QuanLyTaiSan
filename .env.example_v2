# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=quan_ly_tai_san

# JWT — Access Token (short-lived)
JWT_SECRET=your-access-secret-key-here-min-32-chars!@#$%
JWT_EXPIRES_IN=15m

# JWT — Refresh Token (long-lived, separate secret)
JWT_REFRESH_SECRET=your-refresh-secret-key-here-min-32-chars!@#$%
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Mail Configuration — Choose one provider
MAIL_PROVIDER=gmail
MAIL_FROM=noreply@quanlytaisan.local

# Option 1: Gmail (Recommended)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Option 2: SendGrid (commented out)
# MAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.xxxxx...

# Option 3: SMTP (commented out)
# MAIL_PROVIDER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Application
NODE_ENV=development
PORT=3000
BCRYPT_SALT_ROUNDS=12
